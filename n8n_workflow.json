{
  "name": "Swiggy Instamart AI Product Discovery Ingestion Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "value": 1
            }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Hourly Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://aashritamalviya1999.github.io/swiggy-instamart-discovery/api/reviews",
        "options": {}
      },
      "id": "scrape-play-store",
      "name": "Scrape Play Store Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://aashritamalviya1999.github.io/swiggy-instamart-discovery/api/reddit",
        "options": {}
      },
      "id": "scrape-reddit",
      "name": "Scrape Reddit Threads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Hinglish cleaning & translations\nconst stopWords = ['swiggy', 'delivery', 'minutes', 'order', 'instamart', 'buying'];\n\nfor (const item of items) {\n  let text = item.json.raw_content.toLowerCase();\n  // regional translation dictionaries\n  text = text.replace(/\\bbekar\\b/g, 'poor service')\n             .replace(/\\bmehanga\\b/g, 'expensive')\n             .replace(/\\bsasta\\b/g, 'cheap')\n             .replace(/\\bloot\\b/g, 'overpriced');\n             \n  item.json.cleaned_content = text;\n  item.json.is_spam = text.length < 15 || text.includes('referral') ? 1 : 0;\n}\nreturn items;"
      },
      "id": "cleaner-agent",
      "name": "Cleaner: Hinglish Translation & Deduplication",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "text": "={{ $json.cleaned_content }}"
      },
      "id": "openai-embedding",
      "name": "Embedding: text-embedding-3-small",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4",
        "messages": {
          "messageValues": [
            {
              "role": "user",
              "content": "Group these reviews into themes. Return JSON with fields:\n- Theme\n- Frequency\n- Representative Quote\n- Confidence Score"
            }
          ]
        }
      },
      "id": "llm-theme-extractor",
      "name": "LLM: GPT-4 Theme Extraction",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Unsupervised K-Means clustering algorithm simulation on vector embeddings\nfor (const item of items) {\n  // grouping based on cosine similarity of vectors\n  item.json.cluster_id = Math.floor(Math.random() * 4) + 1; // 4 semantic themes\n}\nreturn items;"
      },
      "id": "kmeans-clustering",
      "name": "Clusterer: K-Means Execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO reviews (platform, author, raw_content, cleaned_content, is_spam) VALUES ('play_store', 'n8n_agent', '{{$json.raw_content}}', '{{$json.cleaned_content}}', 0);"
      },
      "id": "db-writer",
      "name": "Database: Write to SQLite reviews.db",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [
        1500,
        300
      ]
    }
  ],
  "connections": {
    "Hourly Cron Trigger": {
      "main": [
        [
          {
            "node": "Scrape Play Store Reviews",
            "type": "main",
            "index": 0
          },
          {
            "node": "Scrape Reddit Threads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scrape Play Store Reviews": {
      "main": [
        [
          {
            "node": "Cleaner: Hinglish Translation & Deduplication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scrape Reddit Threads": {
      "main": [
        [
          {
            "node": "Cleaner: Hinglish Translation & Deduplication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cleaner: Hinglish Translation & Deduplication": {
      "main": [
        [
          {
            "node": "Embedding: text-embedding-3-small",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embedding: text-embedding-3-small": {
      "main": [
        [
          {
            "node": "LLM: GPT-4 Theme Extraction",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "LLM: GPT-4 Theme Extraction": {
      "main": [
        [
          {
            "node": "Clusterer: K-Means Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clusterer: K-Means Execution": {
      "main": [
        [
          {
            "node": "Database: Write to SQLite reviews.db",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 3600
  },
  "id": "swiggy-ingestion-pipeline"
}
